# Groq chat completion (optional until a key is configured)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Local embedding model (downloaded on first run; no hosted embedding API)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Persistent local Qdrant storage
QDRANT_COLLECTION=astra-rag
QDRANT_LOCAL_PATH=./qdrant_storage

# API server
HOST=127.0.0.1
PORT=8000
